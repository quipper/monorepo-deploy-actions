{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>int128/typescript-action-renovate-config#v2.0.0",
    ":automergeMinor",
    ":reviewer(team:sre-jp)"
  ],
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "timezone": "Asia/Tokyo",
  "schedule": [
    "after 10am and before 3pm on Monday"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 10am and before 3pm on Monday"
    ]
  },
  "minimumReleaseAge": "7 days",
  "labels": [
    "renovate",
    "renovate/{{depName}}",
    "{{packageFileDir}}"
  ],
  "packageRules": [
    {
      "description": "Split updates per action",
      "matchFileNames": [
        "*/**"
      ],
      "additionalBranchPrefix": "{{packageFileDir}}-",
      "commitMessageSuffix": "({{packageFileDir}})",
      "matchPackageNames": [
        "!node",
        "!@tsconfig/node*",
        "!@types/node",
        "!@actions/*",
        "!pnpm"
      ]
    },
    {
      "description": "Hold typescript major update: @vercel/ncc's ts-loader calls ts.sys.fileExists, which TypeScript 7 doesn't expose yet (no compiler API), so every build fails with 'Cannot read properties of undefined (reading fileExists)'",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
